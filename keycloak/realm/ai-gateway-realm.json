        { "type": "password", "value": "carol", "temporary": false }
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Support",
      "email": "dave@acme.example.com",
      "attributes": {
        "plan": ["gold"],
        "org": ["acme"],
        "team": ["support"]
      },
      "groups": ["/model-users", "/acme/support"],
      "credentials": [
        { "type": "password", "value": "dave", "temporary": false }
      ]
    },
    {
      "username": "erin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Platform",
      "email": "erin@globex.example.com",
      "attributes": {
        "plan": ["free"],
        "org": ["globex"],
        "team": ["platform"]
      },
      "groups": ["/model-users", "/globex/platform"],
      "credentials": [
        { "type": "password", "value": "erin", "temporary": false }
      ]
    }
  ]
}
