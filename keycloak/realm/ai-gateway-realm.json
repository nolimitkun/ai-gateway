      "lastName": "Builder",
      "email": "bob@example.com",
      "attributes": { "plan": ["free"] },
      "groups": ["/model-users"],
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ]
    },
    {
      "username": "mallory",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Guest",
      "email": "mallory@example.com",
      "attributes": { "plan": ["free"] },
      "groups": ["/guests"],
      "credentials": [
        { "type": "password", "value": "mallory", "temporary": false }
      ]
    },
    {
      "username": "carol",
