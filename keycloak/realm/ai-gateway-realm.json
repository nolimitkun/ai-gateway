{
  "realm": "ai-gateway",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 3600,
  "groups": [
    { "name": "platform-admins" },
    { "name": "model-users" },
    { "name": "guests" }
  ],
  "clientScopes": [
    {
      "name": "ai-gateway-claims",
      "description": "Claims the gateway policies authorize on: groups, plan, audience.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "plan",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "plan",
            "claim.name": "plan",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "ai-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ai-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "ai-gateway-cli",
      "name": "AI gateway comparison CLI",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["ai-gateway-claims"],
      "optionalClientScopes": []
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "email": "alice@example.com",
      "attributes": { "plan": ["gold"] },
      "groups": ["/platform-admins", "/model-users"],
      "credentials": [
        { "type": "password", "value": "alice", "temporary": false }
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "email": "bob@example.com",
      "attributes": { "plan": ["free"] },
      "groups": ["/model-users"],
      "credentials": [
        { "type": "password", "value": "bob", "temporary": false }
      ]
    },
    {
      "username": "mallory",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Mallory",
      "lastName": "Guest",
      "email": "mallory@example.com",
      "attributes": { "plan": ["free"] },
      "groups": ["/guests"],
      "credentials": [
        { "type": "password", "value": "mallory", "temporary": false }
      ]
    }
  ]
}
