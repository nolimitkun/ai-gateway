# Optional overlay: same effect as the Envoy side's toolSelector.
# Apply with:
#   kubectl --context kind-ai-gw-agent apply -f agentgateway/manifests/08-mcp-toolfilter.yaml.optional
---
# Tool filtering. Where Envoy AI Gateway uses a static toolSelector include list
# on the MCPRoute backendRef, agentgateway evaluates a CEL rule per item:
# list operations filter non-matching tools out, and call operations are
# rejected. Variables are `mcp.tool.name` and `mcp.tool.target`.
apiVersion: agentgateway.dev/v1alpha1
kind: AgentgatewayPolicy
metadata:
  name: mcp-toolfilter
  namespace: ai-demo
spec:
  targetRefs:
    - group: agentgateway.dev
      kind: AgentgatewayBackend
      name: mcp
  backend:
    mcp:
      authorization:
        action: Allow
        policy:
          matchExpressions:
            - 'mcp.tool.name == "add" || mcp.tool.target == "clock"'
